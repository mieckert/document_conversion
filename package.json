{
  "name": "salesforce-document-converter",
  "version": "1.0.0",
  "description": "Document conversion service for Salesforce using LibreOffice and Pub/Sub API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --testPathPattern=tests/unit",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:all": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify": "node verify-setup.js"
  },
  "keywords": ["salesforce", "document-conversion", "libreoffice", "pubsub"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.10",
    "avsc": "^5.7.7",
    "axios": "^1.6.0",
    "dotenv": "^16.4.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/jest": "^29.5.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0"
  }
}
